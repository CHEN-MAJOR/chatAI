# API
DATABASE_URL="mysql://chatai:chatai_pass@localhost:3306/chatai"
SHADOW_DATABASE_URL="mysql://root:chatai_root@localhost:3306/chatai_shadow"
PORT=4000
WEB_ORIGIN="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# AI provider
# 默认供应商：mock | openai | openai-compatible | deepseek | qwen | kimi | gemini | custom
# 完整的供应商配置示例见 apps/api/.env.example
# AI_PROVIDER=mock

# DeepSeek
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODELS="deepseek-chat,deepseek-reasoner"

# 通义千问
# QWEN_API_KEY=""
# QWEN_MODELS="qwen-plus,qwen-max,qwen-turbo"

# Kimi
# KIMI_API_KEY=""
# KIMI_MODELS="kimi-latest,moonshot-v1-32k,moonshot-v1-128k"

# OpenAI
# OPENAI_API_KEY=""
# OPENAI_MODELS="gpt-4o-mini,gpt-4o"

# Google Gemini（OpenAI 兼容端点）
# GEMINI_API_KEY=""
# GEMINI_MODELS="gemini-2.5-flash,gemini-3.6-flash,gemini-pro-latest"

# 自定义 OpenAI 兼容服务
# AI_PROVIDER=openai-compatible
# AI_BASE_URL="https://your-gateway.example.com/v1"
# AI_API_KEY=""
# AI_MODELS="model-a,model-b"

# 代理（可选）
# HTTPS_PROXY="http://127.0.0.1:7890"
# HTTP_PROXY="http://127.0.0.1:7890"
